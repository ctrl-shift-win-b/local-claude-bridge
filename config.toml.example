[bridge]
host = "0.0.0.0"                       # Bind address (fix for security issue #2)
port = 1235                              # Anthropic-compatible API listen port
llama_base_url = "http://localhost:1234" # OpenAI-compatible llama.cpp server URL

[bridge.logging]
debug = false                            # Enable verbose DEBUG messages in bridge.log

[poke]
enabled = true
max_retries = 2
delay_seconds = 1.0

[vision]
mode = "external"                        # One of: disabled, internal, external
api_url = "http://<vision-server-host>:1234/v1/chat/completions"
model = "qwen/qwen3-vl-4b"
max_tokens = 4096
temperature = 0.3
timeout = 60.0

[tools]
count_tokens_enabled = true
handled_tools = ["web_search", "web_fetch"]
tool_max_iter = 8

[thinking]
enabled = true                           # When false, disables thinking and strips blocks

# Second OpenAI-compatible server for nested Haiku jobs (WebFetch extract,
# title gen). Env vars override this file: AGENTS_ENABLED, AGENTS_BASE_URL,
# AGENTS_MODEL, AGENTS_MAX_TOKENS, AGENTS_TIMEOUT, AGENTS_CONNECT_TIMEOUT,
# AGENTS_TEMPERATURE. --agents-url on the launcher also wins.
# base_url may be http://host:1234 or .../v1/chat/completions.
# If the second box is down, jobs fall back to the main model with the same cap.
[agents]
enabled = false
base_url = "http://<agents-host>:1234"
model = "qwen/qwen3-vl-4b"
max_tokens = 1024
max_input_tokens = 16000
timeout = 60.0
connect_timeout = 2.0
temperature = 0.3
